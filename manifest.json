{
  "manifest_version": 3,
  "name": "QueueTTS: listen later",
  "short_name": "QueueTTS",
  "version": "3.0.0",
  "description": "Add articles and selected text to a queue, then listen in order with your computer's voices. Everything stays in your browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tts",
    "contextMenus",
    "alarms",
    "favicon"
  ],
  "action": {
    "default_title": "QueueTTS",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "pages/panel.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open QueueTTS"
    },
    "queue-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Add this page, or the selected text, to the queue"
    },
    "toggle-playback": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Play or pause"
    },
    "skip-forward": {
      "description": "Forward one sentence"
    },
    "skip-back": {
      "description": "Back one sentence"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
