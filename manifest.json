{
  "manifest_version": 3,
  "name": "QueueTTS",
  "short_name": "QueueTTS",
  "version": "2.2.0",
  "description": "A compact local-first Chrome extension for capturing web text, queueing it, and listening later with browser text-to-speech.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel",
    "tts",
    "alarms"
  ],
  "action": {
    "default_title": "QueueTTS",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "options_page": "pages/options.html",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
